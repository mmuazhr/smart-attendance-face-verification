# Generate a key with: presenceguard generate-key
PRESENCEGUARD_TEMPLATE_KEY=
PRESENCEGUARD_ADMIN_TOKEN=

# Paths are local; models and runtime databases are Git-ignored.
PRESENCEGUARD_DATABASE_PATH=./data/private/presenceguard.db
PRESENCEGUARD_YUNET_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
PRESENCEGUARD_SFACE_MODEL_PATH=./models/face_recognition_sface_2021dec.onnx

# Verification policy defaults; calibrate before real deployment.
PRESENCEGUARD_MATCH_THRESHOLD=0.363
PRESENCEGUARD_DETECTION_THRESHOLD=0.90
PRESENCEGUARD_DUPLICATE_WINDOW_SECONDS=300
